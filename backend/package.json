{
  "name": "bladesmith-admin-backend",
  "version": "1.0.0",
  "description": "Bladesmith Admin Panel Backend - Express.js + PostgreSQL + JWT",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop bladesmith",
    "pm2:restart": "pm2 restart bladesmith",
    "pm2:reload": "pm2 reload bladesmith",
    "pm2:logs": "pm2 logs bladesmith",
    "pm2:status": "pm2 list"
