  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.35.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.0",
    "pdfkit": "^0.17.1",
    "pm2": "^7.0.1",
    "qrcode": "^1.5.4",
    "redis": "^4.6.0",
    "stripe": "^22.2.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
