# ═══════════════════════════════════════════════════════════
# Bladesmith Production Environment Variables
# Copy this to .env on the production server and fill in values.
# ═══════════════════════════════════════════════════════════

# ─── SERVER ───────────────────────────────────────────────
# REQUIRED
NODE_ENV=production
PORT=5000
HOST=127.0.0.1

# ─── DOMAIN ──────────────────────────────────────────────
# REQUIRED — your live domain (used for CORS, canonical URLs)
FRONTEND_URL=https://YOUR_DOMAIN.COM

# ─── SUPABASE DATABASE ───────────────────────────────────
# REQUIRED — Supabase project credentials
SUPABASE_URL=https://riunzxzmaxmleahaheux.supabase.co
SUPABASE_KEY=your-supabase-service-role-key-here
# ⚠️  ROTATE BEFORE GO-LIVE: Generate a new service role key in Supabase dashboard

# ─── AUTHENTICATION ──────────────────────────────────────
# REQUIRED — JWT secret for admin auth tokens
JWT_SECRET=generate-a-new-64-byte-secret-here
# ⚠️  ROTATE BEFORE GO-LIVE: Run `openssl rand -base64 64` to generate

# ─── REDIS CACHE ─────────────────────────────────────────
# REQUIRED — Redis connection for caching layer
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=set-a-strong-redis-password-here
DISABLE_REDIS=false

# ─── GOOGLE ANALYTICS ────────────────────────────────────
# REQUIRED — GA4 Measurement ID (format: G-XXXXXXXXXX)
GOOGLE_ANALYTICS_KEY=G-XXXXXXXXXX

# ─── AI FEATURES ─────────────────────────────────────────
# OPTIONAL — Gemini API for AI chat/descriptions
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# ─── CLOUDFLARE (if using tunnel) ────────────────────────
# OPTIONAL — only if routing through Cloudflare tunnel
# CLOUDFLARE_TUNNEL_DOMAIN=your-tunnel.trycloudflare.com
