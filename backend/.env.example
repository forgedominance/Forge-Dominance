# ─── Server ───
PORT=5000
NODE_ENV=production

# ─── Supabase (REQUIRED) ───
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# ─── JWT Authentication (REQUIRED) ───
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRE=1h
JWT_REFRESH_EXPIRE=7d

# ─── Redis Cache (OPTIONAL - app works without it) ───
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
DISABLE_REDIS=false

# ─── Frontend URL for CORS (REQUIRED in production) ───
FRONTEND_URL=https://yourdomain.com

# ─── Cloudflare Tunnel (OPTIONAL) ───
CLOUDFLARE_TUNNEL_DOMAIN=

# ─── File Uploads ───
MAX_UPLOAD_MB=5

# ─── NOTE ───
# SMTP credentials, Stripe keys, and AI keys are stored in
# Supabase admin_settings table (managed via Admin Panel > Settings).
# They do NOT need to be in this .env file.


